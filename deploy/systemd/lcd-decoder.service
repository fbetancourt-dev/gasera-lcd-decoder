[Unit]
Description=LCD Display Decoder Service
After=network.target sound.target

[Service]
Type=simple
User=orangepi
WorkingDirectory=/home/orangepi/Documents/lcd-display-analyzer
ExecStart=/usr/bin/python3 /home/orangepi/Documents/lcd-display-analyzer/lcd_decoder_server.py --host 0.0.0.0 --port 8081
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
